{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,

    /* CLAUDE.md TIER 1 kural 5 — `any` kullanilmaz */
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,

    /* CLAUDE.md TIER 1 kural 11 — systems/, util/, data/, types/ Phaser'i
       yalniz `import type` ile alir. verbatimModuleSyntax tip-only
       import'lari derlemede siler; `import type` yazilmadiginda calisma
       zamani bagimliligi BIRAKIR, yani kural ihlali gizli kalmaz. */
    "verbatimModuleSyntax": true
  },
  "include": ["src", "scripts", "vite.config.ts", "vitest.config.ts"]
}
